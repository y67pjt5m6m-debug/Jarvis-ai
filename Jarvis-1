<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JARVIS AI</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #050b14;
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app {
      width: 100%;
      max-width: 700px;
      height: 100vh;
      max-height: 850px;
      display: flex;
      flex-direction: column;
      background: #08111f;
    }

    header {
      padding: 20px;
      text-align: center;
      border-bottom: 1px solid #18304a;
    }

    header h1 {
      margin: 0;
      font-size: 28px;
      letter-spacing: 4px;
    }

    header p {
      margin: 8px 0 0;
      color: #7fa8c9;
    }

    #chat {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }

    .message {
      margin-bottom: 15px;
      padding: 13px 16px;
      border-radius: 14px;
      max-width: 85%;
      line-height: 1.5;
    }

    .jarvis {
      background: #10243a;
      border: 1px solid #1c4669;
      margin-right: auto;
    }

    .user {
      background: #164d70;
      margin-left: auto;
    }

    .input-area {
      display: flex;
      gap: 8px;
      padding: 15px;
      border-top: 1px solid #18304a;
    }

    input {
      flex: 1;
      padding: 14px;
      border-radius: 10px;
      border: 1px solid #31516d;
      background: #0c1928;
      color: white;
      outline: none;
    }

    button {
      border: none;
      border-radius: 10px;
      padding: 12px 15px;
      background: #168acb;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #20a4ed;
    }
  </style>
</head>

<body>

  <div class="app">

    <header>
      <h1>JARVIS AI</h1>
      <p>Your AI assistant</p>
    </header>

    <div id="chat">
      <div class="message jarvis">
        Hello. I am JARVIS. How can I help you?
      </div>
    </div>

    <div class="input-area">
      <input
        id="userInput"
        type="text"
        placeholder="Ask JARVIS something..."
        onkeydown="if(event.key === 'Enter') sendMessage()"
      >

      <button onclick="sendMessage()">Send</button>
    </div>

  </div>

  <script>
    function sendMessage() {
      const input = document.getElementById("userInput");
      const chat = document.getElementById("chat");

      const message = input.value.trim();

      if (!message) return;

      const userMessage = document.createElement("div");
      userMessage.className = "message user";
      userMessage.textContent = message;

      chat.appendChild(userMessage);

      input.value = "";

      const jarvisMessage = document.createElement("div");
      jarvisMessage.className = "message jarvis";

      jarvisMessage.textContent =
        "I received your message. My AI brain is being connected next.";

      chat.appendChild(jarvisMessage);

      chat.scrollTop = chat.scrollHeight;
    }
  </script>

</body>
</html>